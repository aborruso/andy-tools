#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

run=false
debug=false
cache=false

cache_search() {
  if ! command -v howcli-cache >/dev/null 2>&1; then
    echo "Cache search requires howcli-cache. Run: make -C tools/pi-shell-command install" >&2
    return 1
  fi

  local top_command status

  if [ "$#" -eq 0 ] || [ -z "$*" ]; then
    top_command="$(howcli-cache top 2>/dev/null || true)"
    howcli-cache list
    status=$?
  else
    top_command="$(howcli-cache top "$@" 2>/dev/null || true)"
    howcli-cache search "$@"
    status=$?
  fi

  if [ "$status" -eq 0 ] && [ -n "$top_command" ]; then
    copy_to_clipboard "$top_command" || true
  fi

  return "$status"
}

cache_save() {
  if ! command -v howcli-cache >/dev/null 2>&1; then
    return 0
  fi

  local debug_flag=()
  if [ "$debug" = true ]; then
    debug_flag=(--debug)
  fi

  howcli-cache save --query "$1" --command "$2" "${debug_flag[@]}" >/dev/null 2>&1 || true
}

copy_to_clipboard() {
  if command -v timeout >/dev/null 2>&1; then
    if command -v wl-copy >/dev/null 2>&1 && printf '%s' "$1" | timeout 2s wl-copy >/dev/null 2>&1; then
      return 0
    elif command -v xclip >/dev/null 2>&1 && printf '%s' "$1" | timeout 2s xclip -selection clipboard >/dev/null 2>&1; then
      return 0
    elif command -v pbcopy >/dev/null 2>&1 && printf '%s' "$1" | timeout 2s pbcopy >/dev/null 2>&1; then
      return 0
    elif command -v clip.exe >/dev/null 2>&1 && printf '%s\n' "$1" | timeout 2s clip.exe >/dev/null 2>&1; then
      return 0
    fi
  else
    if command -v wl-copy >/dev/null 2>&1; then
      printf '%s' "$1" | wl-copy >/dev/null 2>&1 && return 0
    elif command -v xclip >/dev/null 2>&1; then
      printf '%s' "$1" | xclip -selection clipboard >/dev/null 2>&1 && return 0
    elif command -v pbcopy >/dev/null 2>&1; then
      printf '%s' "$1" | pbcopy >/dev/null 2>&1 && return 0
    elif command -v clip.exe >/dev/null 2>&1; then
      printf '%s\n' "$1" | clip.exe >/dev/null 2>&1 && return 0
    fi
    return 1
  fi

  return 1
}

while [ "$#" -gt 0 ]; do
  case "${1:-}" in
    --run)
      run=true
      shift
      ;;
    --debug)
      debug=true
      shift
      ;;
    -c|--cache)
      cache=true
      shift
      ;;
    --version)
      printf 'howcli %s\n' "$VERSION"
      exit 0
      ;;
    -h|--help)
      break
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

case "${1:-}" in
  -h|--help)
    cat >&2 <<'EOF'
Usage:
  howcli "natural language request"
  howcli --run "natural language request"
  howcli --debug "natural language request"
  howcli -c "cache search"
  howcli --cache "cache search"
  howcli --version

By default, howcli prints the generated shell command and copies it to the system clipboard when available.
Use --run to ask for confirmation and execute it.
Use --debug to keep stderr visible in generated commands.
Use -c or --cache to search previous generated commands without calling Pi.
EOF
    exit 0
    ;;
esac

if [ "$cache" = true ]; then
  set +e
  cache_search "$@"
  cache_status=$?
  set -e
  exit "$cache_status"
fi

if [ "$#" -eq 0 ]; then
  echo 'Usage: howcli "natural language request"' >&2
  exit 2
fi

request="$*"

debug_flag=()
if [ "$debug" = true ]; then
  debug_flag=(--shell-command-debug)
fi

command="$(pi -p \
  --model openai-codex/gpt-5.5 \
  --shell-command \
  "${debug_flag[@]}" \
  --no-session \
  --no-tools \
  --no-context-files \
  --no-skills \
  --no-prompt-templates \
  "$request")"

if [ -z "$command" ]; then
  echo "No command generated." >&2
  exit 1
fi

cache_save "$request" "$command"
copy_to_clipboard "$command" || true

printf '%s\n' "$command"

if [ "$run" != true ]; then
  exit 0
fi

printf 'Eseguire? [Y/n] ' >&2

if ! IFS= read -r answer; then
  printf '\n' >&2
  exit 130
fi

case "${answer,,}" in
  ""|y|yes|s|si|sì)
    exec bash -c "$command"
    ;;
  n|no)
    exit 0
    ;;
  *)
    echo "Non eseguo." >&2
    exit 1
    ;;
esac
