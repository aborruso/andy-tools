#!/usr/bin/env bash
set -euo pipefail

run=false

copy_to_clipboard() {
  if command -v timeout >/dev/null 2>&1; then
    if command -v wl-copy >/dev/null 2>&1 && printf '%s' "$1" | timeout 2s wl-copy >/dev/null 2>&1; then
      return 0
    elif command -v xclip >/dev/null 2>&1 && printf '%s' "$1" | timeout 2s xclip -selection clipboard >/dev/null 2>&1; then
      return 0
    elif command -v pbcopy >/dev/null 2>&1 && printf '%s' "$1" | timeout 2s pbcopy >/dev/null 2>&1; then
      return 0
    elif command -v clip.exe >/dev/null 2>&1 && printf '%s\n' "$1" | timeout 2s clip.exe >/dev/null 2>&1; then
      return 0
    fi
  else
    if command -v wl-copy >/dev/null 2>&1; then
      printf '%s' "$1" | wl-copy >/dev/null 2>&1
    elif command -v xclip >/dev/null 2>&1; then
      printf '%s' "$1" | xclip -selection clipboard >/dev/null 2>&1
    elif command -v pbcopy >/dev/null 2>&1; then
      printf '%s' "$1" | pbcopy >/dev/null 2>&1
    elif command -v clip.exe >/dev/null 2>&1; then
      printf '%s\n' "$1" | clip.exe >/dev/null 2>&1
    else
      return 1
    fi
  fi

  return 1
}

case "${1:-}" in
  --run)
    run=true
    shift
    ;;
  -h|--help)
    cat >&2 <<'EOF'
Usage:
  howcli "natural language request"
  howcli --run "natural language request"

By default, howcli prints the generated shell command and copies it to the system clipboard when available.
Use --run to ask for confirmation and execute it.
EOF
    exit 0
    ;;
esac

if [ "$#" -eq 0 ]; then
  echo 'Usage: howcli "natural language request"' >&2
  exit 2
fi

command="$(pi -p \
  --shell-command \
  --no-session \
  --no-tools \
  --no-context-files \
  --no-skills \
  --no-prompt-templates \
  "$*")"

if [ -z "$command" ]; then
  echo "No command generated." >&2
  exit 1
fi

copy_to_clipboard "$command" || true

printf '%s\n' "$command"

if [ "$run" != true ]; then
  exit 0
fi

printf 'Eseguire? [Y/n] ' >&2

if ! IFS= read -r answer; then
  printf '\n' >&2
  exit 130
fi

case "${answer,,}" in
  ""|y|yes|s|si|sì)
    exec bash -lc "$command"
    ;;
  n|no)
    exit 0
    ;;
  *)
    echo "Non eseguo." >&2
    exit 1
    ;;
esac
