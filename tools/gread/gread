#!/usr/bin/env bash
# Resolve source directory: next to script if running from repo,
# or from share/gread if installed via make.
script_dir="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
if [[ -f "$script_dir/src/index.tsx" ]]; then
  src="$script_dir/src/index.tsx"
elif [[ -f "$HOME/share/gread/src/index.tsx" ]]; then
  src="$HOME/share/gread/src/index.tsx"
else
  echo "gread: source files not found" >&2
  exit 1
fi
exec npx tsx "$src" "$@"
