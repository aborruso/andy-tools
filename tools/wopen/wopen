#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  wopen [file|directory|url]
  wopen -s [file|directory]
  wopen -c <file>
  wopen --help

Open a file, directory, or URL from WSL/Linux with Windows.

Behavior:
  - WSL/Linux files are converted with wslpath and opened with the default Windows app.
  - WSL/Linux directories are converted with wslpath and opened in Windows File Explorer.
  - Paths under /mnt/c/... work like any other WSL/Linux path.
  - Windows paths are passed through unchanged.
  - URLs are opened with the default Windows handler, usually the browser.
  - With -s: opens a new Windows Terminal in the target directory.
    If a file is given, opens the terminal in its parent directory.
  - With -c: copies the file content to the Windows clipboard (files only).

Examples:
  wopen
  wopen info.md
  wopen /home/user/info.md
  wopen .
  wopen /mnt/c/Users/user/Desktop/trash
  wopen 'C:\Users\user\Desktop\info.md'
  wopen https://example.com
  wopen -s
  wopen -s /home/user/projects
  wopen -s info.md
  wopen -c info.md
  wopen -c /home/user/notes.txt

Agent-friendly notes:
  - Non-interactive: never prompts for input.
  - With no arguments, opens the current directory, like `wopen .`.
  - Requires at most one argument (plus optional -s or -c flag).
  - Fails fast with an actionable error when a path or required command is missing.

Exit codes:
  0  Open command was sent to Windows.
  1  Runtime error, such as missing WSL command or missing path.
  2  Invalid usage.
USAGE
}

is_url() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]]
}

is_windows_path() {
  [[ "$1" =~ ^[A-Za-z]:[\\/] ]] || [[ "$1" =~ ^\\\\ ]]
}

report_windows_failure() {
  local action="$1"
  local program="$2"
  local status="$3"
  local output="${4:-}"

  echo "wopen: error: failed to ${action} via ${program}." >&2

  if [[ $status -eq 126 ]] || [[ "$output" == *"Exec format error"* ]]; then
    echo "Windows executable was found but could not run from this session." >&2
    if [[ -n "${WSL_INTEROP:-}" ]]; then
      echo "WSL interop appears configured (WSL_INTEROP is set), but this process cannot launch Windows binaries." >&2
    else
      echo "WSL interop does not appear to be available in this session (WSL_INTEROP is not set)." >&2
    fi
    return
  fi

  if [[ $status -eq 127 ]] || [[ "$output" == *"command not found"* ]]; then
    echo "${program} is not runnable from PATH in this session." >&2
    return
  fi

  if [[ -n "$output" ]]; then
    echo "$output" >&2
  fi
  echo "This environment may not allow Windows interop from the current session." >&2
}

require_powershell() {
  if ! command -v powershell.exe >/dev/null 2>&1; then
    echo "wopen: error: powershell.exe not found." >&2
    echo "This tool must run inside WSL with Windows interop enabled." >&2
    echo "Run: wopen --help" >&2
    exit 1
  fi
}

open_via_powershell() {
  local action="$1"
  local target="$2"
  set +e
  output=$(powershell.exe -NoProfile -NonInteractive -Command '& { param($p) Start-Process -FilePath $p -ErrorAction Stop }' "$target" 2>&1)
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    report_windows_failure "$action" "powershell.exe" "$status" "$output"
    exit 1
  fi
}

shell_mode=false
copy_mode=false

if [[ ( ${1:-} == "-s" && ( ${2:-} == "-c" || ${2:-} == "--copy" ) ) || \
      ( ( ${1:-} == "-c" || ${1:-} == "--copy" ) && ${2:-} == "-s" ) ]]; then
  echo "wopen: error: -c and -s cannot be used together." >&2
  echo "Run: wopen --help" >&2
  exit 2
fi

if [[ ${1:-} == "-s" ]]; then
  shell_mode=true
  shift
elif [[ ${1:-} == "-c" || ${1:-} == "--copy" ]]; then
  copy_mode=true
  shift
fi

if [[ $# -gt 1 ]]; then
  echo "wopen: error: expected at most one argument." >&2
  echo "Run: wopen --help" >&2
  exit 2
fi

input=${1:-.}

if [[ "$input" == "-h" || "$input" == "--help" ]]; then
  usage
  exit 0
fi

if $shell_mode; then
  if is_url "$input" || is_windows_path "$input"; then
    echo "wopen: error: -s does not support URLs or Windows paths." >&2
    exit 2
  fi

  if ! command -v wslpath >/dev/null 2>&1; then
    echo "wopen: error: wslpath not found." >&2
    echo "Required to convert WSL/Linux paths to Windows paths." >&2
    exit 1
  fi

  if [[ ! -e "$input" ]]; then
    echo "wopen: error: path not found: $input" >&2
    exit 1
  fi

  if ! command -v wt.exe >/dev/null 2>&1; then
    echo "wopen: error: wt.exe not found." >&2
    echo "Required to open Windows Terminal." >&2
    exit 1
  fi

  if [[ -d "$input" ]]; then
    dir=$input
  else
    dir=$(dirname "$input")
  fi

  windir=$(wslpath -w "$dir")
  set +e
  output=$(wt.exe -d "$windir" 2>&1)
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    report_windows_failure "open Windows Terminal" "wt.exe" "$status" "$output"
    exit 1
  fi
  exit 0
fi

if $copy_mode; then
  if is_url "$input" || is_windows_path "$input"; then
    echo "wopen: error: -c does not support URLs or Windows paths." >&2
    exit 2
  fi

  if [[ -d "$input" ]]; then
    echo "wopen: error: -c does not support directories." >&2
    exit 2
  fi

  if [[ ! -f "$input" ]]; then
    echo "wopen: error: file not found: $input" >&2
    exit 1
  fi

  if ! command -v clip.exe >/dev/null 2>&1; then
    echo "wopen: error: clip.exe not found." >&2
    echo "Required to copy file content to Windows clipboard." >&2
    exit 1
  fi

  set +e
  output=$(clip.exe < "$input" 2>&1)
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    report_windows_failure "copy content" "clip.exe" "$status" "$output"
    exit 1
  fi
  exit 0
fi

if is_url "$input"; then
  require_powershell
  open_via_powershell "open URL" "$input"
  exit 0
fi

if is_windows_path "$input"; then
  require_powershell
  open_via_powershell "open Windows path" "$input"
  exit 0
fi

if ! command -v wslpath >/dev/null 2>&1; then
  echo "wopen: error: wslpath not found." >&2
  echo "Required to convert WSL/Linux paths to Windows paths." >&2
  echo "Run: wopen --help" >&2
  exit 1
fi

if [[ ! -e "$input" ]]; then
  echo "wopen: error: path not found: $input" >&2
  echo "Use an existing file or directory, for example:" >&2
  echo "  wopen ." >&2
  echo "  wopen /mnt/c/Users/user/Desktop/trash" >&2
  exit 1
fi

target=$(wslpath -w "$input")

if [[ -d "$input" ]]; then
  if ! command -v explorer.exe >/dev/null 2>&1; then
    echo "wopen: error: explorer.exe not found." >&2
    echo "Required to open directories in Windows File Explorer." >&2
    echo "Run: wopen --help" >&2
    exit 1
  fi
  set +e
  output=$(cd "$input" && explorer.exe . 2>&1)
  status=$?
  set -e
  # explorer.exe returns exit code 1 even on success under WSL, so a bare
  # non-zero status is not reliable. Only treat it as a failure when there is
  # a genuine interop error signature (126/127 or non-empty error output).
  if [[ $status -ne 0 && ( $status -eq 126 || $status -eq 127 || -n "$output" ) ]]; then
    report_windows_failure "open directory" "explorer.exe" "$status" "$output"
    exit 1
  fi
else
  set +e
  output=$(cmd.exe /c start "" "$target" 2>&1)
  status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    report_windows_failure "open file" "cmd.exe" "$status" "$output"
    exit 1
  fi
fi
