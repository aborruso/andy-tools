#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  wopen [file|directory|url]
  wopen -s [file|directory]
  wopen --help

Open a file, directory, or URL from WSL/Linux with Windows.

Behavior:
  - WSL/Linux files are converted with wslpath and opened with the default Windows app.
  - WSL/Linux directories are converted with wslpath and opened in Windows File Explorer.
  - Paths under /mnt/c/... work like any other WSL/Linux path.
  - Windows paths are passed through unchanged.
  - URLs are opened with the default Windows handler, usually the browser.
  - With -s: opens a new Windows Terminal in the target directory.
    If a file is given, opens the terminal in its parent directory.

Examples:
  wopen
  wopen info.md
  wopen /home/user/info.md
  wopen .
  wopen /mnt/c/Users/user/Desktop/trash
  wopen 'C:\Users\user\Desktop\info.md'
  wopen https://example.com
  wopen -s
  wopen -s /home/user/projects
  wopen -s info.md

Agent-friendly notes:
  - Non-interactive: never prompts for input.
  - With no arguments, opens the current directory, like `wopen .`.
  - Requires at most one argument (plus optional -s flag).
  - Fails fast with an actionable error when a path or required command is missing.

Exit codes:
  0  Open command was sent to Windows.
  1  Runtime error, such as missing WSL command or missing path.
  2  Invalid usage.
USAGE
}

shell_mode=false

if [[ ${1:-} == "-s" ]]; then
  shell_mode=true
  shift
fi

if [[ $# -gt 1 ]]; then
  echo "wopen: error: expected at most one argument." >&2
  echo "Run: wopen --help" >&2
  exit 2
fi

input=${1:-.}

if [[ "$input" == "-h" || "$input" == "--help" ]]; then
  usage
  exit 0
fi

if ! command -v powershell.exe >/dev/null 2>&1; then
  echo "wopen: error: powershell.exe not found." >&2
  echo "This tool must run inside WSL with Windows interop enabled." >&2
  echo "Run: wopen --help" >&2
  exit 1
fi

is_url() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]]
}

is_windows_path() {
  [[ "$1" =~ ^[A-Za-z]:[\\/] ]] || [[ "$1" =~ ^\\\\ ]]
}

if $shell_mode; then
  if is_url "$input" || is_windows_path "$input"; then
    echo "wopen: error: -s does not support URLs or Windows paths." >&2
    exit 2
  fi

  if ! command -v wslpath >/dev/null 2>&1; then
    echo "wopen: error: wslpath not found." >&2
    echo "Required to convert WSL/Linux paths to Windows paths." >&2
    exit 1
  fi

  if [[ ! -e "$input" ]]; then
    echo "wopen: error: path not found: $input" >&2
    exit 1
  fi

  if ! command -v wt.exe >/dev/null 2>&1; then
    echo "wopen: error: wt.exe not found." >&2
    echo "Required to open Windows Terminal." >&2
    exit 1
  fi

  if [[ -d "$input" ]]; then
    dir=$input
  else
    dir=$(dirname "$input")
  fi

  windir=$(wslpath -w "$dir")
  wt.exe -d "$windir" >/dev/null 2>&1 || true
  exit 0
fi

if is_url "$input"; then
  target=$input
  powershell.exe -NoProfile -NonInteractive -Command '& { param($p) Start-Process -FilePath $p -ErrorAction Stop }' "$target" >/dev/null 2>&1 || true
  exit 0
fi

if is_windows_path "$input"; then
  target=$input
  powershell.exe -NoProfile -NonInteractive -Command '& { param($p) Start-Process -FilePath $p -ErrorAction Stop }' "$target" >/dev/null 2>&1 || true
  exit 0
fi

if ! command -v wslpath >/dev/null 2>&1; then
  echo "wopen: error: wslpath not found." >&2
  echo "Required to convert WSL/Linux paths to Windows paths." >&2
  echo "Run: wopen --help" >&2
  exit 1
fi

if [[ ! -e "$input" ]]; then
  echo "wopen: error: path not found: $input" >&2
  echo "Use an existing file or directory, for example:" >&2
  echo "  wopen ." >&2
  echo "  wopen /mnt/c/Users/user/Desktop/trash" >&2
  exit 1
fi

target=$(wslpath -w "$input")

if [[ -d "$input" ]]; then
  if ! command -v explorer.exe >/dev/null 2>&1; then
    echo "wopen: error: explorer.exe not found." >&2
    echo "Required to open directories in Windows File Explorer." >&2
    echo "Run: wopen --help" >&2
    exit 1
  fi
  ( cd "$input" && explorer.exe . ) >/dev/null 2>&1 || true
else
  cmd.exe /c start "" "$target" >/dev/null 2>&1 || true
fi
