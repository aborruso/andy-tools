#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$SCRIPT_DIR/package.json" && -f "$SCRIPT_DIR/src/index.js" ]]; then
  exec node "$SCRIPT_DIR/src/index.js" "$@"
fi

DATADIR="${PROJUMP_DATADIR:-$HOME/share/projump}"
exec node "$DATADIR/src/index.js" "$@"
